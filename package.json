{
  "name": "akzem-intelligence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
