PORT=3001
# Vercel production: set this to your public HTTPS origin before creating invitations.
# APP_BASE_URL=https://your-project.vercel.app

# Vercel hosted database (Neon/PostgreSQL). Leave blank for local SQLite development.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required to open the administrator area. Use your own strong password.
AKZEM_ADMIN_EMAIL=
AKZEM_ADMIN_PASSWORD=

# Optional: defaults to the persistent SQLite file in ./data.
# AKZEM_DATABASE_PATH=C:/path/to/akzem.sqlite

# OpenAI API credentials. Keep your real key in .env, never in frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
